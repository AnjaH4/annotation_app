#: surveyapp/templates/taskInstructions.html:8
#: surveyapp/templates/taskInstructions.html:15
msgid "Task Instructions"
msgstr "Navodila za nalogo"

#: surveyapp/templates/taskInstructions.html:17
#, python-format
msgid ""
"\n"
"        <p><br><i>The data you submit will be kept anonymous.</i></p>\n"
"        <p style=\"padding-left:0%%\"><br> Your task is as follows:</p>\n"
"        <p ><br>for each image shown to you, you are asked to decide whether "
"it is </p>\n"
"        <p style=\"padding-left: 4%%;\"><br>an image of a real human face "
"<br><br>or <br><br>an artificial image that has been created by this AI "
"technology.<br></p>\n"
"        "
msgstr ""
"\n"
"        <p><br><i>Podatki, ki jih pošljete, bodo ostali anonimni.</i></p>\n"
"        <p style=\"padding-left:0%%\"><br> Vaša naloga je naslednja:</p>\n"
"        <p ><br>za vsako prikazano sliko morate odločiti, ali gre za </p>\n"
"        <p style=\"padding-left: 4%%;\"><br>sliko resničnega človeškega obraza "
"<br><br>ali <br><br>umetno sliko, ki je bila ustvarjena s to tehnologijo UI.<br></p>\n"
"        "

#: surveyapp/templates/taskInstructions.html:27
msgid ""
"\n"
"        <p><hr><br>You will also be asked for the level of <b>confidence</b> "
"you have in each of these answers.<br><br></p>\n"
"        "
msgstr ""
"\n"
"        <p><hr><br>Prav tako boste vprašani o stopnji <b>zaupanja</b>, ki jo imate v vsak od teh odgovorov.<br><br></p>\n"
"        "

#: surveyapp/templates/taskInstructions.html:41
msgid ""
"\n"
"        <p><br>In addition, you will see a <b>copy of the image with a grid</"
"b> over it.<br><br></p>\n"
"        <p>Here we ask you to <u>click the grid-squares containing any parts "
"of the image that affected your decision</u>.<br><br><hr><br></p>\n"
"        "
msgstr ""
"\n"
"        <p><br>Poleg tega boste videli <b>kopijo slike z mrežo</b> čez njo.<br><br></p>\n"
"        <p>Tu vas prosimo, da <u>kliknete na kvadratke mreže, ki vsebujejo dele slike, ki so vplivali na vašo odločitev</u>.<br><br><hr><br></p>\n"
"        "

